{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do produto"
    },
    "type": {
      "type": "string",
      "enum": [
        "camiseta",
        "baby_look",
        "bone",
        "quadro",
        "caneca",
        "poster",
        "ecobag",
        "almofada",
        "logo_uniforme",
        "vestido",
        "saia",
        "jaqueta",
        "moletom",
        "regata",
        "calca",
        "shorts",
        "colete",
        "cropped",
        "touca"
      ],
      "description": "Tipo do produto"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o comercial do produto"
    },
    "material": {
      "type": "string",
      "description": "Material principal"
    },
    "fit": {
      "type": "string",
      "description": "Modelagem"
    },
    "category_id": {
      "type": "string",
      "description": "Categoria vinculada"
    },
    "collection_id": {
      "type": "string",
      "description": "Cole\u00e7\u00e3o vinculada"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Tags de busca"
    },
    "catalog_product": {
      "type": "boolean",
      "default": false,
      "description": "Modelo dispon\u00edvel no est\u00fadio"
    },
    "front_model_url": {
      "type": "string",
      "description": "Imagem real frontal"
    },
    "back_model_url": {
      "type": "string",
      "description": "Imagem real traseira"
    },
    "product_color_variants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "hex": {
            "type": "string"
          },
          "front_url": {
            "type": "string"
          },
          "back_url": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "hex",
          "front_url",
          "back_url"
        ]
      }
    },
    "design_id": {
      "type": "string",
      "description": "Design aplicado"
    },
    "design_image": {
      "type": "string",
      "description": "URL do design"
    },
    "back_design_image": {
      "type": "string",
      "description": "Arte das costas"
    },
    "base_price": {
      "type": "number",
      "description": "Pre\u00e7o base legado"
    },
    "base_cost": {
      "type": "number",
      "description": "Custo de fabrica\u00e7\u00e3o"
    },
    "artist_margin": {
      "type": "number",
      "default": 0,
      "description": "Lucro definido pelo artista"
    },
    "platform_fee": {
      "type": "number",
      "default": 0,
      "description": "Taxa calculada da plataforma"
    },
    "final_price": {
      "type": "number",
      "description": "Custo base + margem do artista + taxa da plataforma"
    },
    "mockup_url": {
      "type": "string",
      "description": "Mockup principal"
    },
    "mockup_gallery": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mockup_style": {
      "type": "string",
      "enum": [
        "studio",
        "external",
        "beige",
        "artistic"
      ]
    },
    "mockup_angles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "colors_available": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sizes_available": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "type",
    "base_price"
  ]
}