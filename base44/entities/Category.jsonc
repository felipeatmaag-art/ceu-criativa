{
  "name": "Category",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome da categoria"
    },
    "slug": {
      "type": "string",
      "description": "Identificador amig\u00e1vel \u00fanico"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da categoria"
    },
    "icon": {
      "type": "string",
      "description": "Emoji ou nome do \u00edcone"
    },
    "position_order": {
      "type": "integer",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o"
    }
  },
  "required": [
    "name",
    "slug"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}