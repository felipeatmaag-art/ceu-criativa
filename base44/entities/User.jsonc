{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user",
        "curator"
      ],
      "default": "user",
      "description": "Papel t\u00e9cnico de autentica\u00e7\u00e3o"
    },
    "app_role": {
      "type": "string",
      "enum": [
        "master",
        "admin",
        "artist",
        "user"
      ],
      "default": "user",
      "description": "Papel funcional no C\u00e9u Criativa"
    },
    "access_status": {
      "type": "string",
      "enum": [
        "active",
        "disabled"
      ],
      "default": "active",
      "description": "Situa\u00e7\u00e3o do acesso"
    },
    "artist_name": {
      "type": "string",
      "description": "Nome art\u00edstico do usu\u00e1rio"
    },
    "bio": {
      "type": "string",
      "description": "Biografia do artista"
    },
    "avatar_url": {
      "type": "string",
      "description": "URL do avatar"
    },
    "cover_image": {
      "type": "string",
      "description": "Imagem de capa do perfil e da loja"
    },
    "store_name": {
      "type": "string",
      "description": "Nome p\u00fablico do estabelecimento ou loja"
    },
    "store_slug": {
      "type": "string",
      "pattern": "^(?:[a-z0-9]+(?:-[a-z0-9]+)*)?$",
      "description": "Endere\u00e7o \u00fanico da vitrine p\u00fablica"
    },
    "pix_key": {
      "type": "string",
      "description": "Chave PIX para recebimentos"
    },
    "whatsapp": {
      "type": "string",
      "description": "WhatsApp comercial"
    },
    "linkedin": {
      "type": "string",
      "description": "Link do perfil no LinkedIn"
    },
    "instagram": {
      "type": "string",
      "description": "Username do Instagram"
    },
    "twitter": {
      "type": "string",
      "description": "Username do Twitter"
    },
    "website": {
      "type": "string",
      "description": "Website pessoal"
    },
    "artist_commission_rate": {
      "type": "number",
      "default": 25,
      "minimum": 10,
      "maximum": 50,
      "description": "Taxa de comiss\u00e3o do artista"
    },
    "total_sales": {
      "type": "number",
      "default": 0
    },
    "total_earnings": {
      "type": "number",
      "default": 0
    }
  },
  "required": []
}