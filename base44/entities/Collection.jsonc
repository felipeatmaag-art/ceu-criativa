{
  "name": "Collection",
  "type": "object",
  "properties": {
    "artist_id": {
      "type": "string",
      "description": "ID do artista"
    },
    "artist_name": {
      "type": "string",
      "description": "Nome do artista"
    },
    "title": {
      "type": "string",
      "description": "Nome da cole\u00e7\u00e3o"
    },
    "slug": {
      "type": "string",
      "description": "Identificador amig\u00e1vel da cole\u00e7\u00e3o"
    },
    "banner_url": {
      "type": "string",
      "description": "Imagem de banner da cole\u00e7\u00e3o"
    },
    "cover_image": {
      "type": "string",
      "description": "Imagem de capa legada"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da cole\u00e7\u00e3o"
    },
    "design_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Artes na ordem de exibi\u00e7\u00e3o"
    },
    "position_order": {
      "type": "integer",
      "default": 0,
      "description": "Ordem da cole\u00e7\u00e3o na loja"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Cole\u00e7\u00e3o ativa na loja"
    },
    "is_public": {
      "type": "boolean",
      "default": false,
      "description": "Cole\u00e7\u00e3o p\u00fablica"
    },
    "theme": {
      "type": "string",
      "enum": [
        "verao",
        "inverno",
        "minimalista",
        "natureza",
        "urbano",
        "vintage",
        "geometrico",
        "pop_art",
        "surreal",
        "personalizado"
      ],
      "default": "personalizado",
      "description": "Tema do kit tem\u00e1tico"
    }
  },
  "required": [
    "title",
    "artist_id",
    "slug"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.is_public": true
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.artist_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}