{
  "name": "Reward",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Nome do brinde"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do brinde"
    },
    "image_url": {
      "type": "string",
      "description": "Imagem do brinde"
    },
    "points_cost": {
      "type": "number",
      "description": "Custo em pontos"
    },
    "category": {
      "type": "string",
      "enum": [
        "adesivos",
        "chaveiros",
        "camisetas",
        "bones",
        "canecas",
        "exclusivos"
      ],
      "description": "Categoria do brinde"
    },
    "stock": {
      "type": "number",
      "default": 0,
      "description": "Quantidade em estoque"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Brinde dispon\u00edvel"
    }
  },
  "required": [
    "title",
    "points_cost",
    "category"
  ]
}