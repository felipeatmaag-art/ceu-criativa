{
  "name": "CompetitionSubmission",
  "type": "object",
  "properties": {
    "competition_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "artist_id": {
      "type": "string"
    },
    "artist_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "approved",
        "disqualified"
      ],
      "default": "approved"
    }
  },
  "required": [
    "competition_id",
    "title",
    "image_url",
    "artist_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "data.artist_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}