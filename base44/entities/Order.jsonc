{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "base_product_id": {
            "type": "string"
          },
          "variant_id": {
            "type": "string"
          },
          "product_type": {
            "type": "string"
          },
          "design_id": {
            "type": "string"
          },
          "design_title": {
            "type": "string"
          },
          "artist_id": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "size": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "cart_item_id": {
            "type": "string"
          },
          "design_image": {
            "type": "string"
          },
          "mockup_url": {
            "type": "string"
          },
          "production": {
            "type": "object"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "shipping_cost": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "producing",
        "shipped",
        "delivered",
        "cancelled"
      ],
      "default": "pending"
    },
    "payment_intent_id": {
      "type": "string"
    },
    "checkout_key": {
      "type": "string"
    },
    "checkout_token_hash": {
      "type": "string"
    },
    "settlement_lock": {
      "type": "string"
    },
    "settlement_expires": {
      "type": "number",
      "default": 0
    },
    "shipping_address": {
      "type": "object",
      "properties": {
        "street": {
          "type": "string"
        },
        "number": {
          "type": "string"
        },
        "complement": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "zipcode": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "customer_email",
    "items",
    "total"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}