{
  "name": "Design",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Nome da estampa"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o art\u00edstica do design"
    },
    "image_url": {
      "type": "string",
      "description": "URL da imagem do design"
    },
    "artist_id": {
      "type": "string",
      "description": "ID do artista criador"
    },
    "artist_name": {
      "type": "string",
      "description": "Nome do artista"
    },
    "category": {
      "type": "string",
      "enum": [
        "abstrato",
        "natureza",
        "urbano",
        "minimalista",
        "ilustracao",
        "tipografia",
        "geometrico",
        "vintage",
        "pop_art",
        "surreal"
      ],
      "description": "Categoria do design"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags para busca"
    },
    "price_base": {
      "type": "number",
      "description": "Pre\u00e7o base do design"
    },
    "commission_rate": {
      "type": "number",
      "description": "Taxa de comiss\u00e3o do artista (0-100)"
    },
    "sales_count": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de vendas"
    },
    "likes_count": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de curtidas"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Design em destaque"
    },
    "is_ai_generated": {
      "type": "boolean",
      "default": false,
      "description": "Criado com IA"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "pendente",
        "aprovado",
        "rejeitado"
      ],
      "default": "rascunho"
    },
    "production": {
      "type": "object",
      "description": "Snapshot versionado: arquivos PNG originais e limpos, SHA256, dimens\u00f5es, alfa, dpi efetivo, posi\u00e7\u00f5es em coordenadas 1000, \u00e1rea estimada e mockups aprovados",
      "properties": {
        "version": {
          "type": "integer"
        },
        "catalog_product_id": {
          "type": "string"
        },
        "product_type": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "size": {
          "type": "string"
        },
        "approved_at": {
          "type": "string"
        },
        "front": {
          "type": "object"
        },
        "back": {
          "type": "object"
        },
        "print_area": {
          "type": "object"
        },
        "mockup_front_url": {
          "type": "string"
        },
        "mockup_back_url": {
          "type": "string"
        },
        "base_front_url": {
          "type": "string"
        },
        "base_back_url": {
          "type": "string"
        },
        "technical_review": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "title",
    "image_url",
    "category"
  ]
}