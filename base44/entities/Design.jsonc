{
  "name": "Design",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Nome da estampa"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o art\u00edstica"
    },
    "image_url": {
      "type": "string",
      "description": "URL da imagem"
    },
    "artist_id": {
      "type": "string",
      "description": "Artista criador"
    },
    "artist_name": {
      "type": "string",
      "description": "Nome do artista"
    },
    "category": {
      "type": "string",
      "enum": [
        "abstrato",
        "natureza",
        "urbano",
        "minimalista",
        "ilustracao",
        "tipografia",
        "geometrico",
        "vintage",
        "pop_art",
        "surreal"
      ],
      "description": "Categoria legada"
    },
    "category_id": {
      "type": "string",
      "description": "Categoria vinculada"
    },
    "collection_id": {
      "type": "string",
      "description": "Cole\u00e7\u00e3o vinculada"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Tags para busca"
    },
    "price_base": {
      "type": "number",
      "description": "Margem do artista mais taxa da plataforma"
    },
    "base_cost": {
      "type": "number",
      "default": 0,
      "description": "Custo de fabrica\u00e7\u00e3o de refer\u00eancia"
    },
    "artist_margin": {
      "type": "number",
      "default": 0,
      "description": "Lucro desejado pelo artista"
    },
    "platform_fee": {
      "type": "number",
      "default": 0,
      "description": "Taxa calculada da plataforma"
    },
    "final_price": {
      "type": "number",
      "default": 0,
      "description": "Pre\u00e7o final de refer\u00eancia"
    },
    "commission_rate": {
      "type": "number",
      "description": "Percentual central do artista"
    },
    "position_order": {
      "type": "integer",
      "default": 0,
      "description": "Ordem na cole\u00e7\u00e3o"
    },
    "sales_count": {
      "type": "number",
      "default": 0
    },
    "likes_count": {
      "type": "number",
      "default": 0
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "is_ai_generated": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "pendente",
        "aprovado",
        "rejeitado"
      ],
      "default": "rascunho"
    },
    "review_note": {
      "type": "string"
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "production": {
      "type": "object",
      "description": "Snapshot t\u00e9cnico de produ\u00e7\u00e3o",
      "properties": {
        "version": {
          "type": "integer"
        },
        "catalog_product_id": {
          "type": "string"
        },
        "product_type": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "size": {
          "type": "string"
        },
        "approved_at": {
          "type": "string"
        },
        "front": {
          "type": "object"
        },
        "back": {
          "type": "object"
        },
        "print_area": {
          "type": "object"
        },
        "mockup_front_url": {
          "type": "string"
        },
        "mockup_back_url": {
          "type": "string"
        },
        "base_front_url": {
          "type": "string"
        },
        "base_back_url": {
          "type": "string"
        },
        "technical_review": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "title",
    "image_url",
    "category"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "aprovado"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "curator"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "curator"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}